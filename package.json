{
  "name": "audiodeck",
  "version": "0.1.0",
  "description": "Tray-resident Windows audio manager: priority auto-switch, volume mixer, device manager",
  "type": "module",
  "author": "Max",
  "main": "out/main/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "reverb-ir": "node scripts/make-reverb-ir.mjs",
    "dist": "node scripts/make-reverb-ir.mjs && node scripts/check-bundle-inputs.mjs && electron-vite build && electron-builder --win",
    "screenshots": "electron-vite build && node scripts/capture-screenshots.mjs",
    "cursors": "electron-vite build && node design/cursor-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
